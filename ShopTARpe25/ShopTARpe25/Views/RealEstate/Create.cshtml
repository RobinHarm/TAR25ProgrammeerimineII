@model ShopTARpe25.Models.RealEstate.EstateCreateViewModel

<div>
    RealEstate Create
</div>

<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="ModifiedAt" type="hidden" />

    <div>
        <label asp-for="Area" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Area" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="Address" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Address" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="RoomNumber" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="RoomNumber" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="BuildingType" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="BuildingType" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Files" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-5">
            <input asp-for="Files" class="form-control" type="file" multiple />
        </div>
    </div>

    @foreach (var file in Model.Image)
    {
        <partial name="_Images" model="file" />
    }

    <input asp-action="create" asp-controller="realestate" type="submit" class="btn btn-primary" value="Create" />
    <a asp-action="Index" asp-controller="realestate" class="btn btn-secondary">Back to List</a>

</form>


